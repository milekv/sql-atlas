{
  "name": "sql-atlas",
  "displayName": "SQL Atlas",
  "description": "Local SQL diagnostics for PostgreSQL, MySQL, SQLite, SQL Server and Oracle.",
  "version": "0.3.0",
  "publisher": "Milosz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/milekv/sql-atlas.git"
  },
  "homepage": "https://github.com/milekv/sql-atlas",
  "bugs": "https://github.com/milekv/sql-atlas/issues",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "sql",
    "postgresql",
    "mysql",
    "sqlite",
    "database",
    "lint"
  ],
  "activationEvents": [
    "onLanguage:sql"
  ],
  "main": "./dist/extension.cjs",
  "icon": "assets/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "sqlAtlas.analyzeCurrentFile",
        "title": "%command.analyze%",
        "category": "SQL Atlas",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "sqlAtlas.openSample",
        "title": "%command.sample%",
        "category": "SQL Atlas",
        "icon": "$(beaker)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "sqlAtlas.analyzeCurrentFile",
          "when": "editorLangId == sql",
          "group": "navigation"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "sqlAtlas.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "trySample",
            "title": "%step.0.title%",
            "description": "%step.0.description%"
          },
          {
            "id": "viewProblems",
            "title": "%step.1.title%",
            "description": "%step.1.description%"
          },
          {
            "id": "configure",
            "title": "%step.2.title%",
            "description": "%step.2.description%"
          }
        ]
      }
    ],
    "configuration": {
      "title": "SQL Atlas",
      "properties": {
        "sqlAtlas.dialect": {
          "type": "string",
          "enum": [
            "postgresql",
            "mysql",
            "sqlite",
            "sqlserver",
            "oracle",
            "generic"
          ],
          "default": "postgresql",
          "description": "%config.sqlAtlas.dialect%"
        },
        "sqlAtlas.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "pl"
          ],
          "default": "auto",
          "scope": "resource",
          "description": "%config.sqlAtlas.language%"
        },
        "sqlAtlas.minimumSeverity": {
          "type": "string",
          "enum": [
            "critical",
            "warning",
            "info"
          ],
          "default": "info",
          "description": "%config.sqlAtlas.minimumSeverity%"
        },
        "sqlAtlas.ignoreRules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.sqlAtlas.ignoreRules%"
        }
      }
    }
  }
}
